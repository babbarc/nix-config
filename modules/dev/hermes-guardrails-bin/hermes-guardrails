#!/usr/bin/env bash
# hermes-guardrails - print the fleet guardrail tunables (single source of truth).
#
# The values are generated once by modules/dev/hermes-guardrails.nix into
# $HERMES_HOME/guardrails.yaml and consumed here. The SOULs and skills tell the
# agents to read the effective values from this CLI instead of hardcoding
# numbers, so a captain override lands in exactly one place.
#
# Usage:
#   hermes-guardrails show              # human-readable key: value listing
#   hermes-guardrails values            # KEY=value lines (sourceable)
#   hermes-guardrails get <key>         # one value by yaml key
#   hermes-guardrails budget-seconds    # per-task run budget (max_runtime_seconds)
#   hermes-guardrails heartbeat-seconds # required progress-heartbeat cadence
#   hermes-guardrails retry-bound       # identical retries before a hard stop
#   hermes-guardrails lock-path         # fleet-wide desktop lock path
#   hermes-guardrails lock-ttl-seconds  # desktop lock TTL
#   hermes-guardrails live-app-auth-dir # captain live-app grant directory
#   hermes-guardrails live-app-grant-ttl-seconds # default grant lifetime
#
# The fallbacks below mirror the module defaults and are used only when
# $HERMES_HOME/guardrails.yaml is missing (e.g. the CLI run by hand).

set -euo pipefail

# The guardrail config lives in the DEFAULT hermes root. A dispatcher-spawned
# worker runs with HERMES_HOME=<root>/profiles/<name>, so resolve a
# profile-shaped HERMES_HOME to its grandparent (the engine's own rule) rather
# than looking for a per-profile guardrails.yaml. @HERMES_GUARDRAILS_HOME@ is
# baked in at build time as the fallback when HERMES_HOME is unset.
hermes_root() {
  local home="${1:-${HERMES_HOME:-@HERMES_GUARDRAILS_HOME@}}"
  home="${home%/}"
  case "$home" in
    */profiles/*) printf '%s' "$(dirname "$(dirname "$home")")" ;;
    *) printf '%s' "$home" ;;
  esac
}

guardrails_home="${HERMES_GUARDRAILS_HOME:-$(hermes_root)}"
yaml_file="${HERMES_GUARDRAILS_FILE:-$guardrails_home/guardrails.yaml}"

# Read a flat scalar from the generated yaml. The file is machine-generated with
# one `key: value` per line, so no yaml parser is needed.
yaml_get() {
  local key="$1"
  [ -f "$yaml_file" ] || return 1
  sed -n "s/^[[:space:]]*${key}[[:space:]]*:[[:space:]]*//p" "$yaml_file" \
    | head -n 1 \
    | sed -e 's/^"//' -e 's/"$//'
}

value_or() {
  local key="$1" fallback="$2" got
  got="$(yaml_get "$key" || true)"
  if [ -n "$got" ]; then printf '%s' "$got"; else printf '%s' "$fallback"; fi
}

run_budget="$(value_or run_budget_seconds 1800)"
heartbeat="$(value_or heartbeat_seconds 300)"
retry_bound="$(value_or retry_bound 3)"
lock_path="$(value_or desktop_lock_path "$guardrails_home/run/desktop.lock")"
lock_ttl="$(value_or desktop_lock_ttl_seconds 1800)"
lock_wait="$(value_or desktop_lock_wait_seconds 120)"
live_app_auth_dir="$(value_or live_app_auth_dir "$guardrails_home/live-app-authorization")"
live_app_grant_ttl="$(value_or live_app_grant_ttl_seconds 7200)"

usage() {
  cat <<'EOF'
Usage: hermes-guardrails <command>

  show                 human-readable listing of every guardrail tunable
  values               KEY=value lines, safe to `eval`/`source`
  get <key>            print one value by its guardrails.yaml key
  budget-seconds       per-task run budget (passed as max_runtime_seconds)
  heartbeat-seconds    required progress-heartbeat cadence
  retry-bound          identical retries allowed before a hard stop
  lock-path            fleet-wide desktop lock path
  lock-ttl-seconds     desktop lock time-to-live
  live-app-auth-dir    directory holding the captain's per-task live-app grants
  live-app-grant-ttl-seconds  default lifetime of a captain live-app grant
  help                 this text

Source of truth: $HERMES_HOME/guardrails.yaml (generated by the Nix module).
EOF
}

case "${1:-show}" in
  show)
    cat <<EOF
run_budget_seconds:       ${run_budget}
heartbeat_seconds:        ${heartbeat}
retry_bound:              ${retry_bound}
desktop_lock_path:        ${lock_path}
desktop_lock_ttl_seconds: ${lock_ttl}
desktop_lock_wait_seconds:${lock_wait}
live_app_auth_dir:        ${live_app_auth_dir}
live_app_grant_ttl_seconds:${live_app_grant_ttl}
source:                   ${yaml_file}
EOF
    ;;
  values)
    printf 'HERMES_RUN_BUDGET_SECONDS=%s\n' "${run_budget}"
    printf 'HERMES_HEARTBEAT_SECONDS=%s\n' "${heartbeat}"
    printf 'HERMES_RETRY_BOUND=%s\n' "${retry_bound}"
    printf 'HERMES_DESKTOP_LOCK=%s\n' "${lock_path}"
    printf 'HERMES_DESKTOP_LOCK_TTL=%s\n' "${lock_ttl}"
    printf 'HERMES_DESKTOP_LOCK_WAIT=%s\n' "${lock_wait}"
    printf 'HERMES_LIVE_APP_AUTH_DIR=%s\n' "${live_app_auth_dir}"
    printf 'HERMES_LIVE_APP_GRANT_TTL=%s\n' "${live_app_grant_ttl}"
    ;;
  get)
    key="${2:-}"
    [ -n "$key" ] || { echo "hermes-guardrails get: missing key" >&2; exit 2; }
    case "$key" in
      run_budget_seconds) printf '%s\n' "${run_budget}" ;;
      heartbeat_seconds) printf '%s\n' "${heartbeat}" ;;
      retry_bound) printf '%s\n' "${retry_bound}" ;;
      desktop_lock_path) printf '%s\n' "${lock_path}" ;;
      desktop_lock_ttl_seconds) printf '%s\n' "${lock_ttl}" ;;
      desktop_lock_wait_seconds) printf '%s\n' "${lock_wait}" ;;
      live_app_auth_dir) printf '%s\n' "${live_app_auth_dir}" ;;
      live_app_grant_ttl_seconds) printf '%s\n' "${live_app_grant_ttl}" ;;
      *) echo "hermes-guardrails get: unknown key '$key'" >&2; exit 2 ;;
    esac
    ;;
  budget-seconds)
    printf '%s\n' "${run_budget}"
    ;;
  heartbeat-seconds)
    printf '%s\n' "${heartbeat}"
    ;;
  retry-bound)
    printf '%s\n' "${retry_bound}"
    ;;
  lock-path)
    printf '%s\n' "${lock_path}"
    ;;
  lock-ttl-seconds)
    printf '%s\n' "${lock_ttl}"
    ;;
  live-app-auth-dir)
    printf '%s\n' "${live_app_auth_dir}"
    ;;
  live-app-grant-ttl-seconds)
    printf '%s\n' "${live_app_grant_ttl}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "hermes-guardrails: unknown command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
