#!/usr/bin/env bash
#
# recover-page - AXI-shaped front end to the vendored Hermes-core
# recover_page.py archive ladder. It does NOT reimplement recovery: every
# route, body validation, provenance field and exit code comes from
# recover_page.py unchanged. It only reshapes the output - a content-first
# no-arg / --help view, a one-line `ok: {route, provenance, snapshot_date,
# saved}` with snapshot-age disclosure, and an `ALL_ROUTES_FAILED` route trace
# on total failure instead of a bare hint. Packaged onto PATH by
# modules/dev/hermes-skills.nix, which pins $RECOVER_PAGE_PY to the sibling
# script's store path.
set -euo pipefail

self="recover-page"
: "${RECOVER_PAGE_PY:=$(dirname "$(readlink -f "$0")")/recover_page.py}"
savedir="${RECOVER_PAGE_DIR:-${TMPDIR:-/tmp}}"

usage() {
  cat <<EOF
$self - recover a blocked / paywalled / WAF'd page from a third-party copy.
Run this BEFORE spending a real browser session on a blocked URL.

usage:
  $self <url>          archive ladder -> \`ok: {route, provenance, snapshot_date, saved}\`
  $self <url> --json   full route trace as JSON (recover_page.py passthrough)
  $self --help         this text

ladder (cheapest first, all inside recover_page.py - the canonical Hermes-core script):
  1. Wayback Machine  archive.org "available" API      (dated snapshot)
  2. archive.today    archive.ph -> .md -> .li -> .is   (rotates on 429)
  3. Jina Reader      only if JINA_API_KEY is set       (live re-render; unset here)

help[]:
  the recovered body is written to a FILE (saved: <path>), never dumped to context
  a \`snapshot\` provenance prints its date - cite it WITH the date, and if the
    task needs current values say so to the dispatcher, do not present stale data as live
  on total failure: \`ALL_ROUTES_FAILED\` - then try the site API / RSS / sitemap,
    then \`browse\` as a real session (see the SKILL.md fallback ladder)

exit: 0 body recovered  1 no route worked / operational error  2 bad usage
saved bodies land in $savedir (override with RECOVER_PAGE_DIR)
EOF
}

case "${1:-}" in
  "" | -h | --help | help) usage; exit 0 ;;
esac

url="$1"; shift
json=""
for arg in "$@"; do
  case "$arg" in
    --json) json=1 ;;
    *) printf 'error: unknown argument %q\n' "$arg" >&2; exit 2 ;;
  esac
done

case "$url" in
  http://* | https://*) : ;;
  *) printf 'error: url must start with http:// or https://\n' >&2; exit 2 ;;
esac

mkdir -p "$savedir"
key="$(printf '%s' "$url" | cksum | cut -d' ' -f1)"
out="$savedir/recover-$key.html"

if [ -n "$json" ]; then
  exec python3 "$RECOVER_PAGE_PY" "$url" --out "$out" --json
fi

if ! result="$(python3 "$RECOVER_PAGE_PY" "$url" --out "$out" --json 2>/dev/null)"; then
  printf 'ALL_ROUTES_FAILED - tried wayback, archive.today(x4), api-pivot\n' >&2
  printf 'help[]:\n' >&2
  printf '  no genuine third-party copy found by the archive ladder\n' >&2
  printf '  next: the site own API / RSS / sitemap, then the browse skill as a real session\n' >&2
  exit 1
fi

RECOVER_PAGE_RESULT="$result" python3 <<'PY'
import json, os

r = json.loads(os.environ["RECOVER_PAGE_RESULT"])
ts = r.get("snapshot_timestamp") or ""
date = f"{ts[0:4]}-{ts[4:6]}-{ts[6:8]}" if len(ts) >= 8 else "undated"
print(
    f'ok: {{route: {r["route"]}, provenance: {r["provenance"]}, '
    f'snapshot_date: {date}, saved: {r.get("saved_to")}}}'
)
if r.get("provenance") == "snapshot":
    print("help[]:")
    print(f"  this is a {date} snapshot, not the live page - cite it with the date")
    print("  if the task needs current values, say so to the dispatcher")
PY
